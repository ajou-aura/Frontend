{
  "name": "aura-rn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client --lan --port 8081",
    "start:dev:localhost": "expo start --dev-client --localhost --port 8081",
    "start:dev:lan": "expo start --dev-client --lan --port 8081",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "android:connect": "adb shell am start -a android.intent.action.VIEW -d \"exp+aura-rn://expo-development-client/?url=http%3A%2F%2F10.0.2.2%3A8081\"",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web",
    "contract:check": "node ./scripts/contract-check.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.6",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.16",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.7",
    "expo-notifications": "~55.0.12",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
